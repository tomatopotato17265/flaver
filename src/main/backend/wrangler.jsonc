{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flaver-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flaver-db",
      "database_id": "67910211-3e79-4dd5-8285-fb61188cfc6b"
    }
  ]
}
